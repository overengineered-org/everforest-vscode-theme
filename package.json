{
  "name": "everforest-complete",
  "displayName": "Everforest Complete",
  "description": "Everforest presets plus configurable Light and Dark themes, scheduled switching, and accessibility controls.",
  "version": "0.0.0-development",
  "publisher": "overengineered-org",
  "author": {
    "name": "Overengineered Org"
  },
  "license": "MIT",
  "homepage": "https://github.com/overengineered-org/everforest-vscode-theme#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/overengineered-org/everforest-vscode-theme.git"
  },
  "bugs": {
    "url": "https://github.com/overengineered-org/everforest-vscode-theme/issues"
  },
  "keywords": [
    "everforest",
    "color theme",
    "dark theme",
    "light theme",
    "contrast",
    "customizable"
  ],
  "icon": "media/icon.png",
  "categories": [
    "Themes"
  ],
  "galleryBanner": {
    "color": "#2D353B",
    "theme": "dark"
  },
  "pricing": "Free",
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./dist/extension.js",
  "browser": "./dist/extension-web.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "themes": [
      {
        "label": "Everforest Complete Dark Soft",
        "uiTheme": "vs-dark",
        "path": "./themes/everforest-complete-dark-soft-color-theme.json"
      },
      {
        "label": "Everforest Complete Dark Medium",
        "uiTheme": "vs-dark",
        "path": "./themes/everforest-complete-dark-medium-color-theme.json"
      },
      {
        "label": "Everforest Complete Dark Hard",
        "uiTheme": "vs-dark",
        "path": "./themes/everforest-complete-dark-hard-color-theme.json"
      },
      {
        "label": "Everforest Complete Light Soft",
        "uiTheme": "vs",
        "path": "./themes/everforest-complete-light-soft-color-theme.json"
      },
      {
        "label": "Everforest Complete Light Medium",
        "uiTheme": "vs",
        "path": "./themes/everforest-complete-light-medium-color-theme.json"
      },
      {
        "label": "Everforest Complete Light Hard",
        "uiTheme": "vs",
        "path": "./themes/everforest-complete-light-hard-color-theme.json"
      },
      {
        "label": "Everforest Complete Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/everforest-complete-dark-color-theme.json"
      },
      {
        "label": "Everforest Complete Light",
        "uiTheme": "vs",
        "path": "./themes/everforest-complete-light-color-theme.json"
      }
    ],
    "commands": [
      {
        "command": "everforestComplete.openSettings",
        "title": "Open Premium Settings",
        "category": "Everforest Complete"
      },
      {
        "command": "everforestComplete.regenerateThemes",
        "title": "Regenerate Themes",
        "category": "Everforest Complete"
      }
    ],
    "configuration": {
      "title": "Everforest Complete",
      "properties": {
        "everforestComplete.darkContrast": {
          "type": "string",
          "scope": "application",
          "default": "medium",
          "enum": [
            "soft",
            "medium",
            "hard"
          ],
          "description": "Dark theme background contrast."
        },
        "everforestComplete.lightContrast": {
          "type": "string",
          "scope": "application",
          "default": "medium",
          "enum": [
            "soft",
            "medium",
            "hard"
          ],
          "description": "Light theme background contrast."
        },
        "everforestComplete.darkWorkbench": {
          "type": "string",
          "scope": "application",
          "default": "material",
          "enum": [
            "material",
            "flat",
            "high-contrast"
          ],
          "description": "Dark theme workbench style."
        },
        "everforestComplete.lightWorkbench": {
          "type": "string",
          "scope": "application",
          "default": "material",
          "enum": [
            "material",
            "flat",
            "high-contrast"
          ],
          "description": "Light theme workbench style."
        },
        "everforestComplete.darkCursor": {
          "type": "string",
          "scope": "application",
          "default": "white",
          "enum": [
            "white",
            "red",
            "orange",
            "yellow",
            "green",
            "aqua",
            "blue",
            "purple"
          ],
          "description": "Dark theme cursor color."
        },
        "everforestComplete.lightCursor": {
          "type": "string",
          "scope": "application",
          "default": "black",
          "enum": [
            "black",
            "red",
            "orange",
            "yellow",
            "green",
            "aqua",
            "blue",
            "purple"
          ],
          "description": "Light theme cursor color."
        },
        "everforestComplete.darkSelection": {
          "type": "string",
          "scope": "application",
          "default": "grey",
          "enum": [
            "grey",
            "red",
            "orange",
            "yellow",
            "green",
            "aqua",
            "blue",
            "purple"
          ],
          "description": "Dark theme selection color."
        },
        "everforestComplete.lightSelection": {
          "type": "string",
          "scope": "application",
          "default": "grey",
          "enum": [
            "grey",
            "red",
            "orange",
            "yellow",
            "green",
            "aqua",
            "blue",
            "purple"
          ],
          "description": "Light theme selection color."
        },
        "everforestComplete.italicKeywords": {
          "type": "boolean",
          "scope": "application",
          "default": false,
          "description": "Italicize keywords."
        },
        "everforestComplete.italicComments": {
          "type": "boolean",
          "scope": "application",
          "default": true,
          "description": "Italicize comments."
        },
        "everforestComplete.diagnosticTextBackgroundOpacity": {
          "type": "string",
          "scope": "application",
          "default": "0%",
          "enum": [
            "0%",
            "12.5%",
            "25%",
            "37.5%",
            "50%"
          ],
          "description": "Error, warning, and information background opacity."
        },
        "everforestComplete.highContrast": {
          "type": "boolean",
          "scope": "application",
          "default": false,
          "description": "Add stronger borders across the workbench."
        },
        "everforestComplete.autoSwitch.enabled": {
          "type": "boolean",
          "scope": "application",
          "default": false,
          "description": "Switch themes on schedule. Disable Window: Auto Detect Color Scheme first."
        },
        "everforestComplete.autoSwitch.schedule": {
          "type": "array",
          "scope": "application",
          "default": [
            {
              "time": "07:00",
              "theme": "Everforest Complete Light"
            },
            {
              "time": "19:00",
              "theme": "Everforest Complete Dark"
            }
          ],
          "description": "Theme changes in local 24-hour time.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "time",
              "theme"
            ],
            "properties": {
              "time": {
                "type": "string",
                "pattern": "^([0-1][0-9]|2[0-3]):[0-5][0-9]$",
                "description": "Local time in HH:MM format."
              },
              "theme": {
                "type": "string",
                "enum": [
                  "Everforest Complete Dark",
                  "Everforest Complete Light"
                ],
                "description": "Theme activated at this time."
              }
            }
          }
        }
      }
    }
  },
  "files": [
    "themes/*.json",
    "dist/extension.js",
    "dist/extension-web.js",
    "dist/palette/index.js",
    "dist/schedule.js",
    "dist/semantic.js",
    "dist/syntax/default.js",
    "dist/theme.js",
    "dist/workbench/colors.js",
    "dist/workbench/documented-workbench-colors.json",
    "media/icon.png",
    "media/previews/everforest-complete-variants.webp",
    "README.md",
    "CHANGELOG.md",
    "SUPPORT.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "compile": "tsc --project tsconfig.json",
    "generate": "npm run compile && node dist/generate-themes.js",
    "generate:check": "node scripts/check-generated-themes.mjs",
    "validate": "node scripts/validate-themes.mjs",
    "check:format": "prettier --check .",
    "test:unit": "npm run compile && npm run test:unit:compiled",
    "test:unit:compiled": "node --test --experimental-test-coverage --test-coverage-include=dist/**/*.js --test-coverage-include=scripts/color-contrast.mjs --test-coverage-include=scripts/documented-workbench-color-contract.mjs --test-coverage-include=scripts/workbench-interaction-contract.mjs --test-coverage-lines=95 --test-coverage-branches=95 --test-coverage-functions=95 test/unit/*.test.mjs",
    "test:performance": "npm run compile && npm run test:performance:compiled",
    "test:performance:compiled": "node --test test/performance/*.test.mjs",
    "test:release-package": "node --test test/release-package.test.mjs",
    "verify:static": "npm run clean && npm run compile && npm run test:unit:compiled && npm run test:performance:compiled && npm run generate:check && npm run validate && npm run check:format",
    "test:integration": "npm run package:vsix && npm run test:integration:vsix",
    "test:integration:vsix": "node scripts/run-integration-tests.mjs",
    "test": "npm run test:integration && npm run package:verify && npm run test:release-package",
    "audit:production": "npm audit --omit=dev",
    "vscode:prepublish": "npm run verify:static",
    "package:vsix": "vsce package --no-dependencies --out dist/everforest-complete.vsix",
    "package:verify": "node scripts/validate-package-contents.mjs",
    "release": "release-it --ci"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "12.0.0",
    "@types/node": "^24.13.3",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "conventional-changelog-conventionalcommits": "10.3.0",
    "conventional-recommended-bump": "12.1.0",
    "jszip": "^3.10.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "release-it": "21.0.2",
    "typescript": "^7.0.2"
  }
}
