{
  "name": "everforest-complete",
  "displayName": "Everforest Complete",
  "description": "Eight Everforest themes for VS Code: six fixed presets, two configurable themes, accessible syntax, 14 app-wide controls, and automatic Light/Dark switching.",
  "version": "0.0.0-development",
  "packageManager": "npm@11.9.0",
  "publisher": "overengineered-org",
  "author": {
    "name": "Overengineered Org"
  },
  "license": "MIT",
  "homepage": "https://github.com/overengineered-org/everforest-vscode-theme#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/overengineered-org/everforest-vscode-theme.git"
  },
  "bugs": {
    "url": "https://github.com/overengineered-org/everforest-vscode-theme/issues"
  },
  "keywords": [
    "everforest",
    "vscode",
    "vscode theme",
    "visual studio code",
    "color theme",
    "dark theme",
    "light theme",
    "editor theme",
    "syntax highlighting",
    "accessibility",
    "workbench",
    "terminal colors",
    "auto theme",
    "customizable"
  ],
  "icon": "media/icon.png",
  "categories": [
    "Themes"
  ],
  "galleryBanner": {
    "color": "#2D353B",
    "theme": "dark"
  },
  "pricing": "Free",
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./dist/extension.js",
  "browser": "./dist/extension-web.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "themes": [
      {
        "label": "Everforest Complete Dark Soft",
        "uiTheme": "vs-dark",
        "path": "./themes/everforest-complete-dark-soft-color-theme.json"
      },
      {
        "label": "Everforest Complete Dark Medium",
        "uiTheme": "vs-dark",
        "path": "./themes/everforest-complete-dark-medium-color-theme.json"
      },
      {
        "label": "Everforest Complete Dark Hard",
        "uiTheme": "vs-dark",
        "path": "./themes/everforest-complete-dark-hard-color-theme.json"
      },
      {
        "label": "Everforest Complete Light Soft",
        "uiTheme": "vs",
        "path": "./themes/everforest-complete-light-soft-color-theme.json"
      },
      {
        "label": "Everforest Complete Light Medium",
        "uiTheme": "vs",
        "path": "./themes/everforest-complete-light-medium-color-theme.json"
      },
      {
        "label": "Everforest Complete Light Hard",
        "uiTheme": "vs",
        "path": "./themes/everforest-complete-light-hard-color-theme.json"
      },
      {
        "label": "Everforest Complete Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/everforest-complete-dark-color-theme.json"
      },
      {
        "label": "Everforest Complete Light",
        "uiTheme": "vs",
        "path": "./themes/everforest-complete-light-color-theme.json"
      }
    ],
    "commands": [
      {
        "command": "everforestComplete.configureTheme",
        "title": "Configure Theme",
        "category": "Everforest Complete"
      },
      {
        "command": "everforestComplete.configureAdvancedControls",
        "title": "Configure Advanced Controls",
        "category": "Everforest Complete"
      },
      {
        "command": "everforestComplete.configureAutomaticSwitching",
        "title": "Configure Automatic Light/Dark",
        "category": "Everforest Complete"
      },
      {
        "command": "everforestComplete.regenerateThemes",
        "title": "Regenerate Themes",
        "category": "Everforest Complete"
      }
    ],
    "walkthroughs": [
      {
        "id": "everforestComplete.gettingStarted",
        "title": "Settle into Everforest Complete",
        "description": "A calm, private setup in under two minutes.",
        "when": "!isWeb",
        "steps": [
          {
            "id": "everforestComplete.chooseTheme",
            "title": "Choose your Everforest theme",
            "description": "Open [Color Theme](command:workbench.action.selectTheme) and choose a configurable Light or Dark theme, or one of the six fixed presets.",
            "media": {
              "image": "media/walkthrough/choose-theme.svg",
              "altText": "Light and Dark Everforest workbench surfaces"
            },
            "completionEvents": [
              "onSettingChanged:workbench.colorTheme"
            ]
          },
          {
            "id": "everforestComplete.configureFeel",
            "title": "Configure the feel",
            "description": "Run [Configure Theme](command:everforestComplete.configureTheme) for three guided choices. Use [Advanced Controls](command:everforestComplete.configureAdvancedControls) only when you want finer control.",
            "media": {
              "image": "media/walkthrough/configure-feel.svg",
              "altText": "Three-step native theme configuration"
            },
            "completionEvents": [
              "onContext:everforestComplete.themeConfigurationCompleted"
            ]
          },
          {
            "id": "everforestComplete.automateAppearance",
            "title": "Automate Light and Dark",
            "description": "Run [Configure Automatic Light/Dark](command:everforestComplete.configureAutomaticSwitching) to follow your operating system or an exact local schedule.",
            "media": {
              "image": "media/walkthrough/automate-appearance.svg",
              "altText": "Light and Dark themes changing across a daily timeline"
            },
            "completionEvents": [
              "onContext:everforestComplete.automaticSwitchingCompleted"
            ]
          }
        ]
      }
    ],
    "configuration": [
      {
        "title": "Everforest Complete: Appearance",
        "order": 10,
        "properties": {
          "everforestComplete.darkContrast": {
            "type": "string",
            "scope": "application",
            "default": "medium",
            "order": 10,
            "enum": [
              "soft",
              "medium",
              "hard"
            ],
            "enumItemLabels": [
              "Soft",
              "Medium",
              "Hard"
            ],
            "enumDescriptions": [
              "Gentlest surface separation.",
              "Balanced surface separation.",
              "Strongest surface separation."
            ],
            "markdownDescription": "Dark background contrast. Prefer [Configure Theme](command:everforestComplete.configureTheme)."
          },
          "everforestComplete.lightContrast": {
            "type": "string",
            "scope": "application",
            "default": "medium",
            "order": 20,
            "enum": [
              "soft",
              "medium",
              "hard"
            ],
            "enumItemLabels": [
              "Soft",
              "Medium",
              "Hard"
            ],
            "enumDescriptions": [
              "Gentlest surface separation.",
              "Balanced surface separation.",
              "Strongest surface separation."
            ],
            "markdownDescription": "Light background contrast. Prefer [Configure Theme](command:everforestComplete.configureTheme)."
          },
          "everforestComplete.darkWorkbench": {
            "type": "string",
            "scope": "application",
            "default": "material",
            "order": 30,
            "enum": [
              "material",
              "flat",
              "high-contrast"
            ],
            "enumItemLabels": [
              "Material",
              "Flat",
              "High Contrast"
            ],
            "enumDescriptions": [
              "Tonal depth between editor and supporting surfaces.",
              "One continuous, minimal surface.",
              "Strongest structural separation."
            ],
            "markdownDescription": "Dark workbench style. Prefer [Configure Theme](command:everforestComplete.configureTheme)."
          },
          "everforestComplete.lightWorkbench": {
            "type": "string",
            "scope": "application",
            "default": "material",
            "order": 40,
            "enum": [
              "material",
              "flat",
              "high-contrast"
            ],
            "enumItemLabels": [
              "Material",
              "Flat",
              "High Contrast"
            ],
            "enumDescriptions": [
              "Tonal depth between editor and supporting surfaces.",
              "One continuous, minimal surface.",
              "Strongest structural separation."
            ],
            "markdownDescription": "Light workbench style. Prefer [Configure Theme](command:everforestComplete.configureTheme)."
          }
        }
      },
      {
        "title": "Everforest Complete: Editor",
        "order": 20,
        "properties": {
          "everforestComplete.darkCursor": {
            "type": "string",
            "scope": "application",
            "default": "white",
            "order": 10,
            "enum": [
              "white",
              "red",
              "orange",
              "yellow",
              "green",
              "aqua",
              "blue",
              "purple"
            ],
            "enumItemLabels": [
              "White",
              "Red",
              "Orange",
              "Yellow",
              "Green",
              "Aqua",
              "Blue",
              "Purple"
            ],
            "markdownDescription": "Dark editor and terminal cursor. Prefer [Advanced Controls](command:everforestComplete.configureAdvancedControls)."
          },
          "everforestComplete.lightCursor": {
            "type": "string",
            "scope": "application",
            "default": "black",
            "order": 20,
            "enum": [
              "black",
              "red",
              "orange",
              "yellow",
              "green",
              "aqua",
              "blue",
              "purple"
            ],
            "enumItemLabels": [
              "Black",
              "Red",
              "Orange",
              "Yellow",
              "Green",
              "Aqua",
              "Blue",
              "Purple"
            ],
            "markdownDescription": "Light editor and terminal cursor. Prefer [Advanced Controls](command:everforestComplete.configureAdvancedControls)."
          },
          "everforestComplete.darkSelection": {
            "type": "string",
            "scope": "application",
            "default": "grey",
            "order": 30,
            "enum": [
              "grey",
              "red",
              "orange",
              "yellow",
              "green",
              "aqua",
              "blue",
              "purple"
            ],
            "enumItemLabels": [
              "Grey",
              "Red",
              "Orange",
              "Yellow",
              "Green",
              "Aqua",
              "Blue",
              "Purple"
            ],
            "markdownDescription": "Dark selection emphasis across editor, terminal, and minimap. Prefer [Advanced Controls](command:everforestComplete.configureAdvancedControls)."
          },
          "everforestComplete.lightSelection": {
            "type": "string",
            "scope": "application",
            "default": "grey",
            "order": 40,
            "enum": [
              "grey",
              "red",
              "orange",
              "yellow",
              "green",
              "aqua",
              "blue",
              "purple"
            ],
            "enumItemLabels": [
              "Grey",
              "Red",
              "Orange",
              "Yellow",
              "Green",
              "Aqua",
              "Blue",
              "Purple"
            ],
            "markdownDescription": "Light selection emphasis across editor, terminal, and minimap. Prefer [Advanced Controls](command:everforestComplete.configureAdvancedControls)."
          },
          "everforestComplete.italicKeywords": {
            "type": "boolean",
            "scope": "application",
            "default": false,
            "order": 50,
            "markdownDescription": "Italicize keywords. Prefer [Advanced Controls](command:everforestComplete.configureAdvancedControls)."
          },
          "everforestComplete.italicComments": {
            "type": "boolean",
            "scope": "application",
            "default": true,
            "order": 60,
            "markdownDescription": "Italicize comments. Prefer [Advanced Controls](command:everforestComplete.configureAdvancedControls)."
          }
        }
      },
      {
        "title": "Everforest Complete: Accessibility",
        "order": 30,
        "properties": {
          "everforestComplete.diagnosticTextBackgroundOpacity": {
            "type": "string",
            "scope": "application",
            "default": "0%",
            "order": 10,
            "enum": [
              "0%",
              "12.5%",
              "25%",
              "37.5%",
              "50%"
            ],
            "enumItemLabels": [
              "Off",
              "Subtle, 12.5%",
              "Moderate, 25%",
              "Strong, 37.5%",
              "Maximum, 50%"
            ],
            "enumDescriptions": [
              "No diagnostic fill.",
              "Light diagnostic emphasis.",
              "Balanced diagnostic emphasis.",
              "Prominent diagnostic emphasis.",
              "Maximum diagnostic emphasis."
            ],
            "markdownDescription": "Error, warning, and information background emphasis. Prefer [Advanced Controls](command:everforestComplete.configureAdvancedControls)."
          },
          "everforestComplete.highContrast": {
            "type": "boolean",
            "scope": "application",
            "default": false,
            "order": 20,
            "markdownDescription": "Add stronger borders independently from the workbench style. Prefer [Advanced Controls](command:everforestComplete.configureAdvancedControls)."
          }
        }
      },
      {
        "title": "Everforest Complete: Automation",
        "order": 40,
        "properties": {
          "everforestComplete.autoSwitch.enabled": {
            "type": "boolean",
            "scope": "application",
            "default": false,
            "order": 10,
            "markdownDescription": "Switch themes on a local schedule. Prefer [Configure Automatic Light/Dark](command:everforestComplete.configureAutomaticSwitching), which safely coordinates this with system appearance detection."
          },
          "everforestComplete.autoSwitch.schedule": {
            "type": "array",
            "scope": "application",
            "minItems": 2,
            "maxItems": 2,
            "order": 20,
            "default": [
              {
                "time": "07:00",
                "theme": "Everforest Complete Light"
              },
              {
                "time": "19:00",
                "theme": "Everforest Complete Dark"
              }
            ],
            "markdownDescription": "Exact local switch times. Manage them without JSON using [Configure Automatic Light/Dark](command:everforestComplete.configureAutomaticSwitching).",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "time",
                "theme"
              ],
              "properties": {
                "time": {
                  "type": "string",
                  "pattern": "^([0-1][0-9]|2[0-3]):[0-5][0-9]$",
                  "description": "Local time in HH:MM format."
                },
                "theme": {
                  "type": "string",
                  "enum": [
                    "Everforest Complete Dark",
                    "Everforest Complete Light"
                  ],
                  "description": "Theme activated at this time."
                }
              }
            },
            "allOf": [
              {
                "contains": {
                  "required": [
                    "theme"
                  ],
                  "properties": {
                    "theme": {
                      "const": "Everforest Complete Light"
                    }
                  }
                }
              },
              {
                "contains": {
                  "required": [
                    "theme"
                  ],
                  "properties": {
                    "theme": {
                      "const": "Everforest Complete Dark"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    ]
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SUPPORT.md",
    "dist/configuration-ui.js",
    "dist/configuration.js",
    "dist/extension-web.js",
    "dist/extension.js",
    "dist/palette/index.js",
    "dist/schedule-controller.js",
    "dist/schedule.js",
    "dist/semantic.js",
    "dist/syntax/default.js",
    "dist/theme-file-lock.js",
    "dist/theme-file-transaction.js",
    "dist/theme-regeneration.js",
    "dist/theme.js",
    "dist/workbench/colors.js",
    "dist/workbench/documented-workbench-colors.json",
    "media/icon.png",
    "media/previews/everforest-complete-automation.webp",
    "media/previews/everforest-complete-customization.webp",
    "media/previews/everforest-complete-light-dark.webp",
    "media/previews/everforest-complete-workbench.webp",
    "media/walkthrough/automate-appearance.svg",
    "media/walkthrough/choose-theme.svg",
    "media/walkthrough/configure-feel.svg",
    "package.json",
    "themes/everforest-complete-dark-color-theme.json",
    "themes/everforest-complete-dark-hard-color-theme.json",
    "themes/everforest-complete-dark-medium-color-theme.json",
    "themes/everforest-complete-dark-soft-color-theme.json",
    "themes/everforest-complete-light-color-theme.json",
    "themes/everforest-complete-light-hard-color-theme.json",
    "themes/everforest-complete-light-medium-color-theme.json",
    "themes/everforest-complete-light-soft-color-theme.json"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "compile": "tsc --project tsconfig.json",
    "generate": "npm run compile && node dist/generate-themes.js",
    "generate:check": "node scripts/check-generated-themes.mjs",
    "validate": "node scripts/validate-themes.mjs",
    "check:format": "prettier --check .",
    "test:unit": "npm run compile && npm run test:unit:compiled",
    "test:unit:compiled": "node --test --experimental-test-coverage --test-coverage-include=dist/**/*.js --test-coverage-exclude=dist/extension.js --test-coverage-include=scripts/color-contrast.mjs --test-coverage-include=scripts/documented-workbench-color-contract.mjs --test-coverage-include=scripts/workbench-interaction-contract.mjs --test-coverage-lines=95 --test-coverage-branches=95 --test-coverage-functions=95 test/unit/*.test.mjs",
    "test:performance": "npm run compile && npm run test:performance:compiled",
    "test:performance:compiled": "node --test test/performance/*.test.mjs",
    "test:release-package": "node --test test/release-package.test.mjs",
    "verify:static": "npm run clean && npm run compile && npm run test:unit:compiled && npm run test:performance:compiled && npm run generate:check && npm run validate && npm run check:format",
    "test:integration": "npm run package:vsix && npm run test:integration:vsix",
    "test:integration:vsix": "node scripts/run-integration-tests.mjs",
    "test": "npm run test:integration && npm run package:verify && npm run test:release-package",
    "audit:production": "npm audit --omit=dev",
    "verify:local": "./scripts/verify-local.sh",
    "verify:local:report": "./scripts/verify-local.sh --report-status",
    "vscode:prepublish": "npm run verify:static",
    "package:vsix": "vsce package --no-dependencies --out dist/everforest-complete.vsix && node scripts/package-checksum.mjs dist/everforest-complete.vsix",
    "package:verify": "node scripts/validate-package-contents.mjs",
    "release": "release-it --ci"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "12.0.0",
    "@types/node": "^24.13.3",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "conventional-recommended-bump": "12.1.0",
    "js-yaml": "4.3.1",
    "jszip": "^3.10.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "release-it": "21.0.2",
    "typescript": "^7.0.2"
  }
}
